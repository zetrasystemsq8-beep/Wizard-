# Copy to .env for local CLI use only. Never commit .env. In production these are GitHub Actions secrets.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=            # service_role / secret key. Server-side only, never in the Flutter app.

FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=            # produced by: python -m naijalearn_publisher connect
FB_GRAPH_VERSION=v25.0

# Optional safety limits (defaults shown)
PUBLISH_MAX_PER_RUN=3
PUBLISH_MIN_INTERVAL_SECONDS=3600
PUBLISH_MAX_PER_DAY=3
RETRY_BASE_SECONDS=600
RETRY_CAP_SECONDS=21600
LOCK_TIMEOUT_MINUTES=15
